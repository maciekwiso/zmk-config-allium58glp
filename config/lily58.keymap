#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>

#define LAYER_Base 0
#define LAYER_esc_hold 1
#define LAYER_space_hold 2
#define LAYER_symbols 3
#define LAYER_a_windows 4
#define LAYER_game1 5

/* Key positions */

#define POS_LH_C1R1 0
#define POS_LH_C2R1 1
#define POS_LH_C3R1 2
#define POS_LH_C4R1 3
#define POS_LH_C5R1 4
#define POS_LH_C6R1 5
#define POS_RH_C1R1 6
#define POS_RH_C2R1 7
#define POS_RH_C3R1 8
#define POS_RH_C4R1 9
#define POS_RH_C5R1 10
#define POS_RH_C6R1 11
#define POS_LH_C1R2 12
#define POS_LH_C2R2 13
#define POS_LH_C3R2 14
#define POS_LH_C4R2 15
#define POS_LH_C5R2 16
#define POS_LH_C6R2 17
#define POS_RH_C1R2 18
#define POS_RH_C2R2 19
#define POS_RH_C3R2 20
#define POS_RH_C4R2 21
#define POS_RH_C5R2 22
#define POS_RH_C6R2 23
#define POS_LH_C1R3 24
#define POS_LH_C2R3 25
#define POS_LH_C3R3 26
#define POS_LH_C4R3 27
#define POS_LH_C5R3 28
#define POS_LH_C6R3 29
#define POS_RH_C1R3 30
#define POS_RH_C2R3 31
#define POS_RH_C3R3 32
#define POS_RH_C4R3 33
#define POS_RH_C5R3 34
#define POS_RH_C6R3 35
#define POS_LH_C1R4 36
#define POS_LH_C2R4 37
#define POS_LH_C3R4 38
#define POS_LH_C4R4 39
#define POS_LH_C5R4 40
#define POS_LH_C6R4 41
#define POS_RH_C1R4 42
#define POS_RH_C2R4 43
#define POS_RH_C3R4 44
#define POS_RH_C4R4 45
#define POS_RH_C5R4 46
#define POS_RH_C6R4 47
#define POS_LH_T1 48
#define POS_LH_T2 49
#define POS_LH_T3 50
#define POS_LH_T4 51
#define POS_LH_T5 52
#define POS_RH_T1 53

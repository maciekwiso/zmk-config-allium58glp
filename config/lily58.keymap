#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>

#define LAYER_Base 0
#define LAYER_esc_hold 1
#define LAYER_space_hold 2
#define LAYER_symbols 3
#define LAYER_a_windows 4

&mt {
    flavor = "tap-preferred";
    quick-tap-ms = <200>;
    require-prior-idle-ms = <100>;
    tapping-term-ms = <250>;
};

&lt {
    flavor = "tap-preferred";
    quick-tap-ms = <200>;
    require-prior-idle-ms = <100>;
};

/* Custom Defined Behaviors */
/ {
behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LC(LS(N1))>, <&kp LS(LG(LEFT))>, <&plapprove>;
        };
        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mkp LCLK>, <&lockwin>, <&plapprove>;
        };
};
};

/* Automatically generated macro definitions */
/ {
    macros {

        // windows and keypress
        win_choose: win_choose {
            label = "&WIN_CHOOSE";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings = <&macro_press>
                , <&mo LAYER_a_windows>
                , <&kp LGUI>
                , <&macro_pause_for_release>
                , <&macro_release>
                , <&mo LAYER_a_windows>
                , <&kp LGUI>;
        };

        // lock windows
        lockwin: lockwin {
            label = "&LOCKWIN";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <10>;
            wait-ms = <0>;
            bindings = <&macro_press>
                , <&kp LCTRL>
                , <&kp LALT>
                , <&macro_tap>
                , <&kp END>
                , <&macro_wait_time 2000>
                , <&macro_tap>
                , <&none>
                , <&macro_wait_time 1>
                , <&macro_release>
                , <&kp LALT>
                , <&kp LCTRL>
                , <&macro_tap>
                , <&kp RET>;
        };

        // please approve paste
        plapprove: plapprove {
            label = "&PLAPPROVE";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <20>;
            wait-ms = <30>;
            bindings = <&macro_tap>
                , <&kp P>
                , <&kp L>
                , <&kp E>
                , <&kp A>
                , <&kp S>
                , <&kp E>
                , <&kp SPACE>
                , <&kp A>
                , <&kp P>
                , <&kp P>
                , <&kp R>
                , <&kp O>
                , <&kp V>
                , <&kp E>
                , <&kp SPACE>
                , <&macro_tap>
                , <&kp LC(V)>
                , <&macro_wait_time 30>
                , <&macro_tap>
                , <&kp RET>;
        };

        // tilde slash
        tildsl: tildsl {
            label = "&TILDSL";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <30>;
            wait-ms = <30>;
            bindings = <&macro_tap>
                , <&kp LS(GRAVE)>
                , <&kp FSLH>;
        };
    };
};

/* Automatically generated behavior definitions */
/ {
    behaviors {


        // shift enter
        se: se {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <140>;
            bindings = <&kp>, <&kp>;
            quick-tap-ms = <150>;
        };

        // hold windows key and go to layer with numbers
        mtwc: mtwc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            bindings = <&win_choose>, <&kp>;
            flavor = "tap-preferred";
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
        };
    };
};


/ {
    keymap {
        compatible = "zmk,keymap";

        LAYER_Base {
            display-name = "Base";

            bindings = <
          &mt F12 GRAVE    &mt F1 N1       &mt F2 N2     &mt F3 N3        &mt F4 N4       &mt F5 N5                                                                                  &mt F6 N6          &mt F7 N7            &mt F8 N8        &mt F9 N9         &mt F10 N0    &mt F11 MINUS
                &kp TAB        &kp Q  &mt LS(BSLH) W  &mt LS(N7) E  &mt LS(MINUS) R           &kp T                                                                                      &kp Y              &kp U                &kp I            &kp O              &kp P    &mt RBKT LBKT
 &lt LAYER_esc_hold ESC    &mtwc 0 A     &mt LSHFT S   &mt LCTRL D     &mt LS(N9) F  &mt KP_MINUS G                                                                                      &kp H              &kp J                &kp K            &kp L  &mt LS(SEMI) SEMI  &mt LS(SQT) SQT
           &mt LALT INS  &mt LC(Z) Z     &mt LC(X) X   &mt LC(C) C      &mt LC(V) V           &kp B       &td0                                                              &td1    &mt HOME N          &mt END M  &mt LS(COMMA) COMMA  &mt LS(DOT) DOT      &mt BSLH FSLH      &mt DOWN UP
                                                      &mt LALT INS         &kp BSPC &lt LAYER_space_hold SPACE  &kp DEL                                               &kp LCTRL  &se LSHFT RET  &mo LAYER_symbols             &kp LGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        LAYER_esc_hold {
            display-name = "Lower";

            bindings = <
&none     &none  &none  &none   &none   &none                        &none       &none     &none     &none    &none     &none 
&none     &none  &none  &none   &none   &none                        &none       &none     &none     &none    &none     &none 
&none     &none  &none  &none   &none   &none                        &none       &none     &none     &none    &none     &none 
&none     &none  &none  &none   &none   &none    &none    &none      &none       &none     &none     &none    &none     &none 
                        &none   &none   &none     &none    &none     &none       &none     &none 
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        LAYER_space_hold {
            display-name = "Raise";

            bindings = <
&none     &none  &none  &none   &none   &none                        &none       &none     &none     &none    &none     &none 
&none     &none  &none  &none   &none   &none                        &none       &none     &none     &none    &none     &none 
&none     &none  &none  &none   &none   &none                        &none       &none     &none     &none    &none     &none 
&none     &none  &none  &none   &none   &none    &none    &none      &none       &none     &none     &none    &none     &none 
                        &none   &none   &none     &none    &none     &none       &none     &none 
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
        LAYER_symbols {
            display-name = "Adjust";

            bindings = <
&none     &none  &none  &none   &none   &none                        &none       &none     &none     &none    &none     &none 
&none     &none  &none  &none   &none   &none                        &none       &none     &none     &none    &none     &none 
&none     &none  &none  &none   &none   &none                        &none       &none     &none     &none    &none     &none 
&none     &none  &none  &none   &none   &none    &none    &none      &none       &none     &none     &none    &none     &none 
                        &none   &none   &none     &none    &none     &none       &none     &none 
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
        LAYER_a_windows {
            display-name = "Extra";

            bindings = <
&none     &none  &none  &none   &none   &none                        &none       &none     &none     &none    &none     &none 
&none     &none  &none  &none   &none   &none                        &none       &none     &none     &none    &none     &none 
&none     &none  &none  &none   &none   &none                        &none       &none     &none     &none    &none     &none 
&none     &none  &none  &none   &none   &none    &none    &none      &none       &none     &none     &none    &none     &none 
                        &none   &none   &none     &none    &none     &none       &none     &none 
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
